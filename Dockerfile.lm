# Language Model Dockerfile for braintotext2025 (b2txt25_lm environment)
# Ubuntu-based image with deep learning libraries (PyTorch) for neural decoding
FROM ubuntu:22.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Set working directory
WORKDIR /app

# Install system dependencies including CUDA-compatible libraries
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    openjdk-11-jdk-headless \
    curl \
    git \
    build-essential \
    libhdf5-dev \
    libssl-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment for PySpark
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Upgrade pip and install build tools
RUN python3 -m pip install --upgrade pip setuptools wheel

# Copy requirements first for better caching
COPY requirements.txt pyproject.toml /app/

# Install base Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Install deep learning frameworks
# Using CPU versions by default - modify for GPU support
RUN pip install --no-cache-dir \
    torch==2.1.0 \
    torchvision==0.16.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install additional ML/NLP libraries for language modeling
RUN pip install --no-cache-dir \
    transformers>=4.35.0 \
    datasets>=2.14.0 \
    tokenizers>=0.15.0 \
    accelerate>=0.25.0 \
    sentencepiece>=0.1.99 \
    sacremoses>=0.1.0 \
    nltk>=3.8.1 \
    spacy>=3.7.0

# Copy the entire project
COPY . /app/

# Install the project
RUN pip install -e .

# Create necessary directories
RUN mkdir -p /app/data/01_raw \
    /app/data/02_intermediate \
    /app/data/03_primary \
    /app/data/04_feature \
    /app/data/05_model_input \
    /app/data/06_models \
    /app/data/07_model_output \
    /app/data/08_reporting \
    /app/models/pretrained \
    /app/models/checkpoints

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV KEDRO_LOGGING_CONFIG=/app/conf/logging.yml
ENV TRANSFORMERS_CACHE=/app/models/pretrained
ENV HF_HOME=/app/models/pretrained

# Expose port for Kedro Viz and Jupyter
EXPOSE 4141 8888

# Default command
CMD ["kedro", "run"]
